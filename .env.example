# ============================================================
# TRIDENT — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env to version control.

# --- LLM Provider (agents) ---
# Options: 'groq' (default, cloud) | 'ollama' (local) | 'openai' (optional)
MODEL_PROVIDER=groq

# --- Groq Cloud (default for agents + security evaluator) ---
# API key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Primary Groq model for scenarios (pick one for each experiment run):
#   - Meta Llama 3.3 70B:  llama-3.3-70b-versatile
#   - Qwen3 32B:           qwen/qwen3-32b
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL=qwen/qwen3-32b

# Optional: Groq model for security evaluator only (defaults to llama-3.3-70b-versatile,
# not GROQ_MODEL — avoids TPM contention when crew uses another model).
# GROQ_EVALUATOR_MODEL=llama-3.3-70b-versatile

# Extra CrewAI max_iter for S2 when MODEL_PROVIDER=groq (default 8).
# S2_GROQ_ITER_BOOST=8

# --- OpenAI (optional; only if MODEL_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Ollama (local LLM; MODEL_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Extra CrewAI max_iter when provider is ollama (default 16). Groq/OpenAI use smaller bases.
# Ollama: HR base 12 + extra, Admin base 10 + extra; e.g. HR max_iter = 12+16 = 28.
# OLLAMA_MAX_ITER_EXTRA=16
