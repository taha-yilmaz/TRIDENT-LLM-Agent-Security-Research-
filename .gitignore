# ==============================================================================
# TRIDENT — Project Specific Overrides
# ==============================================================================
# Poisoned test files (generated at runtime)
*_poisoned.txt
*_poisoned.md

# Experiment results (generated at runtime — not for version control)
# Note: The results/ folder itself is tracked via results/.gitkeep
results/experiment_log.jsonl

# Environment Variables
.env
.env.local
*.env

